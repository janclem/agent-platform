{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "!**/node_modules",
      "!**/coverage",
      "!**/dist",
      "!packages/work-graph-cli/src/generated"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/work-graph-cli/src/main.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noShadowRestrictedNames": "warn"
          }
        }
      }
    }
  ]
}
