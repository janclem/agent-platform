{
  "name": "work-graph-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the Work Graph",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.scripts.json",
    "test": "vitest run",
    "test:integration": "bash scripts/test-integration.sh",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "lint:api": "pnpm openapi:check && spectral lint openapi.json --ruleset .spectral.yaml --fail-severity error",
    "smoke:local-runtime": "bash scripts/smoke-local-runtime.sh"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "hono": "^4.7.11",
    "ts-base": "workspace:*",
    "work-graph-db": "workspace:*",
    "work-graph-domain": "workspace:*",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@stoplight/spectral-cli": "6.17.0",
    "@stoplight/spectral-owasp-ruleset": "2.0.1",
    "@types/node": "^24",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4"
  }
}
