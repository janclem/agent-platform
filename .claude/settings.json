{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Read(**/*.tfstate*)",
      "Edit(**/*.tfstate*)",
      "Read(**/*.tfvars)",
      "Edit(**/*.tfvars)",
      "Read(**/bootstrap/**)",
      "Edit(**/bootstrap/**)",
      "Read(~/.ssh/**)",
      "Read(~/.terraform.d/**)",
      "Read(~/.config/sops/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "agent-platform": {
      "source": {
        "source": "github",
        "repo": "janclem/agent-platform"
      }
    }
  },
  "enabledPlugins": {
    "platform@agent-platform": true
  }
}
